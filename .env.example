# Local development
APP_BASE_URL=http://localhost:5000

# Example production URL
# APP_BASE_URL=https://your-app.example.com

# Use staging or production in deployed environments. Leave unset locally.
# APP_ENV=production

DATABASE_URL=postgresql://user:password@localhost:5432/ipray4u
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/ipray4u_test
SECRET_KEY=replace-with-a-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Local/test default is memory://. Staging and production on Render must use
# a shared Redis/Valkey backend, for example redis://... or rediss://...
RATELIMIT_STORAGE_URI=memory://

# Local/test default: no trusted proxies.
# On Render, set TRUSTED_PROXY_COUNT=2 because requests reach the app
# through two trusted proxy hops.
# TRUSTED_PROXY_COUNT=2

# Use True when serving the application over HTTPS.
SESSION_COOKIE_SECURE=False
